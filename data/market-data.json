const app = getApp();

Page({
  data: {
    activeTab: 'sp500',
    currentDate: '',
    updateTime: '',
    pageTitle: '标普500 每日估值',
    scoreValue: '0.0',
    scoreDesc: '数据加载中...',
    scoreBoxClass: 'score-bg-gray',
    scoreTextClass: 'text-gray',
    scoreBarClass: 'progress-gray',
    scoreWidth: 0,
    statusDesc: '数据加载中...',
    statusTag: '加载中',
    statusTagClass: 'tag-gray',
    peValue: '0.0',
    vixValue: '0.00',
    adviceRise: '数据加载中...',
    adviceFall: '数据加载中...',
    multiplierDisplay: '-',
    planAmount: '',
    calcResult: '',
    showPE: false,
    showVIX: false,
    showScore: false,
    showPercentile: false,
    highlightRow: 0,
    highlightCol: 0,
    sp500ChangePercent: '0.00%',
    sp500ChangeClass: 'text-gray',
    nasdaq100ChangePercent: '0.00%',
    nasdaq100ChangeClass: 'text-gray',
    thermoLabel1: '>32',
    thermoLabel7: '<17',
    thermoHeaderLt: '<18',
    thermoHeaderGt: '>35',
    vixTermLt: '<15',
    vixTermGt: '>25',
    etfList: []
  },

  onLoad() {
    this.setDateAndTime();
    
    // 注册页面数据更新回调
    app.registerPageCallback(() => {
      console.log('收到数据更新通知，刷新页面');
      this.setTabData(this.data.activeTab);
    });
    
    // 立即尝试加载数据（如果本地数据已存在）
    if (app.globalData && app.globalData.MARKET_DATA && app.globalData.MARKET_DATA.sp500 && app.globalData.MARKET_DATA.sp500.pe > 0) {
      console.log('使用本地数据初始化');
      this.setTabData('sp500');
    }
  },

  onShow() {
    this.setDateAndTime();
    // 每次显示页面时刷新数据
    if (app.globalData && app.globalData.MARKET_DATA && app.globalData.MARKET_DATA.sp500 && app.globalData.MARKET_DATA.sp500.pe > 0) {
      this.setTabData(this.data.activeTab);
    }
  },

  setDateAndTime() {
    const now = new Date();
    const y = now.getFullYear();
    const m = now.getMonth() + 1;
    const d = now.getDate();
    const h = now.getHours();
    const mi = now.getMinutes();
    this.setData({
      currentDate: y + '年' + m + '月' + d + '日',
      updateTime: (h < 10 ? '0' + h : h) + ':' + (mi < 10 ? '0' + mi : mi)
    });
  },

  setTabData(tab) {
    // 检查数据是否存在
    if (!app.globalData || !app.globalData.MARKET_DATA || !app.globalData.MARKET_DATA[tab]) {
      console.error('数据未准备好:', tab);
      return;
    }
    
    const data = app.globalData.MARKET_DATA[tab];
    const label = tab === 'sp500' ? '标普500' : '纳指100';
    const pe = data.pe;
    const vix = data.vix;
    // 根据PE计算score（基于历史百分位）
    const score = this.calculateScore(pe, tab);

    const result = {};

    result.activeTab = tab;
    result.pageTitle = label + ' 每日估值';

    const spChg = app.globalData.MARKET_DATA.sp500.changePercent;
    const naChg = app.globalData.MARKET_DATA.nasdaq100.changePercent;
    result.sp500ChangePercent = (spChg >= 0 ? '+' : '') + spChg.toFixed(2) + '%';
    result.sp500ChangeClass = spChg >= 0 ? 'text-red' : 'text-green';
    result.nasdaq100ChangePercent = (naChg >= 0 ? '+' : '') + naChg.toFixed(2) + '%';
    result.nasdaq100ChangeClass = naChg >= 0 ? 'text-red' : 'text-green';

    result.scoreValue = score.toFixed(1);

    if (score < 4) {
      result.scoreBoxClass = 'score-bg-green';
      result.scoreTextClass = 'text-green';
      result.scoreBarClass = 'progress-green';
    } else if (score < 6) {
      result.scoreBoxClass = 'score-bg-blue';
      result.scoreTextClass = 'text-blue';
      result.scoreBarClass = 'progress-blue';
    } else if (score < 8) {
      result.scoreBoxClass = 'score-bg-orange';
      result.scoreTextClass = 'text-orange';
      result.scoreBarClass = 'progress-orange';
    } else {
      result.scoreBoxClass = 'score-bg-red';
      result.scoreTextClass = 'text-red';
      result.scoreBarClass = 'progress-red';
    }

    result.scoreWidth = ((score / 10) * 100).toFixed(0);

    let scoreLabel, scoreAdvice;
    if (score < 4) { scoreLabel = '低估'; scoreAdvice = '适合积极布局'; }
    else if (score < 6) { scoreLabel = '适中'; scoreAdvice = '按计划定投'; }
    else if (score < 8) { scoreLabel = '偏高'; scoreAdvice = '保持谨慎'; }
    else { scoreLabel = '高估'; scoreAdvice = '谨慎'; }

    result.scoreDesc = label + '当前' + scoreLabel + '，' + scoreAdvice;

    if (score < 4) {
      result.statusDesc = '更适合积极布局，把握加仓机会。';
      result.statusTag = '偏乐观';
      result.statusTagClass = 'tag-green';
    } else if (score < 6) {
      result.statusDesc = '适合按计划定投，保持稳健节奏。';
      result.statusTag = '稳健';
      result.statusTagClass = 'tag-blue';
    } else if (score < 8) {
      result.statusDesc = '更适合稳节奏，不适合追涨或激进加仓。';
      result.statusTag = '偏谨慎';
      result.statusTagClass = 'tag-orange';
    } else {
      result.statusDesc = '建议观望或减仓，等待更好机会。';
      result.statusTag = '谨慎';
      result.statusTagClass = 'tag-red';
    }

    result.peValue = pe.toFixed(1);
    result.vixValue = vix.toFixed(2);

    if (score >= 7) {
      result.adviceRise = '估值已经偏高，不要追涨。已达到止盈目标的可以分批卖出。';
      result.adviceFall = '估值虽高但下跌是正常的，可以观望。如果跌到适中区间再考虑买入。';
    } else if (score >= 4) {
      result.adviceRise = '估值适中，可以按计划定投。涨幅较大时可以适当减少本次投入。';
      result.adviceFall = '估值适中，下跌是加仓机会。可以适当增加本次定投金额。';
    } else {
      result.adviceRise = '估值偏低是好事，但不要因为涨了就加大投入，保持原计划。';
      result.adviceFall = '估值偏低是很好的加仓机会。可以加大投入力度。';
    }

    const mult = this.getMultiplier(pe, vix);
    result.multiplierDisplay = typeof mult === 'number' ? (mult + '倍') : mult;

    result.highlightRow = this.getHighlightRow(pe);
    result.highlightCol = this.getHighlightCol(vix);

    // 设置 ETF 数据 - 根据当前 tab 筛选对应的 ETF
    const etfType = tab === 'sp500' ? 'sp500' : 'nasdaq';
    if (app.globalData.US_ETFS && app.globalData.US_ETFS.length > 0) {
      const etfs = app.globalData.US_ETFS.filter(etf => etf.type === etfType);
      result.etfList = etfs.map(etf => ({
        ticker: etf.ticker,
        price: etf.price.toFixed(2),
        changePercent: (etf.changePercent >= 0 ? '+' : '') + etf.changePercent.toFixed(2) + '%',
        changeClass: etf.changePercent >= 0 ? 'text-red' : 'text-green'
      }));
    } else {
      result.etfList = [];
    }

    this.setData(result);
  },

  getMultiplier(pe, vix) {
    const vixRange = vix < 18 ? 0 : (vix <= 25 ? 1 : (vix <= 35 ? 2 : 3));
    const peRange = pe > 32 ? 0 : (pe >= 29 ? 1 : (pe >= 26 ? 2 : (pe >= 23 ? 3 : (pe >= 20 ? 4 : (pe >= 17 ? 5 : 6)))));
    const table = [
      [null, null, '观望', 0.3],
      [null, 0.3, 0.5, 0.7],
      [0.3, 0.5, 0.7, 1.0],
      [0.5, 0.7, 1.1, 1.6],
      [0.2, 1.4, 2.2, 3.2],
      [2.0, 3.2, 5.5, 8.0],
      [3.5, 5.8, 10.0, '顶格']
    ];
    const val = table[peRange][vixRange];
    return val != null ? val : 1.0;
  },

  getHighlightRow(pe) {
    if (pe > 32) return 0;
    if (pe >= 29) return 1;
    if (pe >= 26) return 2;
    if (pe >= 23) return 3;
    if (pe >= 20) return 4;
    if (pe >= 17) return 5;
    return 6;
  },

  getHighlightCol(vix) {
    if (vix < 18) return 1;
    if (vix <= 25) return 2;
    if (vix <= 35) return 3;
    return 4;
  },

  calculateScore(pe, indexType) {
    // 基于PE-TTM历史百分位的估值评分计算
    // 
    // 逻辑：
    // 1. 获取当前PE-TTM
    // 2. 计算在历史区间里的位置：(当前PE - 近10年最低PE) / (近10年最高PE - 近10年最低PE)
    // 3. 位置 * 10 = 0-10分
    // 4. 限制在0-1范围内
    //
    // 历史区间（行业公认近10年）：
    // - 标普500(SPY): 最低14, 最高32
    // - 纳指100(QQQ): 最低18, 最高40
    
    const peRanges = {
      sp500: { min: 14, max: 32 },
      nasdaq100: { min: 18, max: 40 }
    };
    
    const range = peRanges[indexType] || peRanges.sp500;
    
    // 第2步：算当前PE在历史区间里的"位置"
    let percentile = (pe - range.min) / (range.max - range.min);
    
    // 限制在0-1范围内（防止PE超出历史区间）
    percentile = Math.max(0, Math.min(1, percentile));
    
    // 第3步：转换成0-10分，保留1位小数
    const score = Math.round(percentile * 100) / 10;
    
    return score;
  },

  switchTab(e) {
    const tab = e.currentTarget.dataset.tab;
    this.setTabData(tab);
  },

  onPlanInput(e) {
    this.setData({ planAmount: e.detail.value });
  },

  onCalculate() {
    const amt = parseFloat(this.data.planAmount);
    if (!amt || isNaN(amt)) {
      wx.showToast({ title: '请输入金额', icon: 'none' });
      return;
    }
    const tab = this.data.activeTab;
    const data = app.globalData.MARKET_DATA[tab];
    const m = this.getMultiplier(data.pe, data.vix);
    const r = typeof m === 'number' ? Math.round(amt * m) : amt;
    this.setData({ calcResult: '建议投入: ¥' + r + ' (' + this.data.multiplierDisplay + ')' });
  },

  onToggle(e) {
    const t = e.currentTarget.dataset.t;
    const k = 'show' + t.charAt(0).toUpperCase() + t.slice(1);
    const obj = {};
    obj[k] = !this.data[k];
    this.setData(obj);
  }
});
